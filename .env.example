# ── Agri360 CRM — Environment Variables ──────────────────────────────
# Copy to `.env` and fill in. Only VITE_-prefixed vars are exposed to the client.

# Base URL of the backend REST API
VITE_API_BASE_URL=https://api.agri360.example.com/v1

# Request timeout (ms)
VITE_API_TIMEOUT=30000

# App metadata
VITE_APP_NAME=Agri360 CRM
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Feature flags
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_DEVTOOLS=true

# Auth token storage key namespace
VITE_AUTH_STORAGE_KEY=agri360.auth
